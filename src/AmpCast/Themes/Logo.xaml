<!--
  AmpCast logo — guitar body outline with an equalizer inside, redrawn in the
  "Deep Discord" palette. 256 × 256 design grid. Same geometry as assets/logo.svg.
  Also read by tools/make-icon.ps1 to generate AmpCast.ico.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <PathGeometry x:Key="LogoGuitarGeometry"
                  Figures="M114,28 L114,100 C114,88 100,74 88,70 C78,67 70,74 72,86 C74,104 84,118 82,134 C80,146 58,158 58,184 C58,212 88,230 128,230 C168,230 198,212 198,184 C198,158 176,146 174,132 C172,116 184,96 182,76 C181,62 172,56 164,62 C154,70 142,84 142,96 L142,28" />

    <GeometryGroup x:Key="LogoBarsGeometry">
        <RectangleGeometry Rect="78.5,184,9,24" RadiusX="4.5" RadiusY="4.5" />
        <RectangleGeometry Rect="93.5,164,9,44" RadiusX="4.5" RadiusY="4.5" />
        <RectangleGeometry Rect="108.5,140,9,68" RadiusX="4.5" RadiusY="4.5" />
        <RectangleGeometry Rect="123.5,114,9,94" RadiusX="4.5" RadiusY="4.5" />
        <RectangleGeometry Rect="138.5,146,9,62" RadiusX="4.5" RadiusY="4.5" />
        <RectangleGeometry Rect="153.5,170,9,38" RadiusX="4.5" RadiusY="4.5" />
        <RectangleGeometry Rect="168.5,188,9,20" RadiusX="4.5" RadiusY="4.5" />
    </GeometryGroup>

    <!-- Two-tone stroke like the original: light neck/horns, glowing purple→blurple body. -->
    <LinearGradientBrush x:Key="LogoStrokeBrush" MappingMode="Absolute" StartPoint="0,28" EndPoint="0,232">
        <GradientStop Color="#F4F4FF" Offset="0" />
        <GradientStop Color="#D3D6FF" Offset="0.5" />
        <GradientStop Color="#AF47FF" Offset="0.56" />
        <GradientStop Color="#5865F2" Offset="1" />
    </LinearGradientBrush>

    <!-- Glow only on the purple body; the light neck stays crisp. -->
    <LinearGradientBrush x:Key="LogoGlowBrush" MappingMode="Absolute" StartPoint="0,28" EndPoint="0,232">
        <GradientStop Color="#00AF47FF" Offset="0.38" />
        <GradientStop Color="#AF47FF" Offset="0.58" />
        <GradientStop Color="#5865F2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoBarsBrush" MappingMode="Absolute" StartPoint="0,114" EndPoint="0,208">
        <GradientStop Color="#D98BFF" Offset="0" />
        <GradientStop Color="#AF47FF" Offset="0.35" />
        <GradientStop Color="#5865F2" Offset="1" />
    </LinearGradientBrush>

    <DrawingGroup x:Key="LogoMarkDrawing">
        <!-- fixed 256×256 bounds -->
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
        <!-- soft neon glow behind the equalizer -->
        <GeometryDrawing>
            <GeometryDrawing.Brush>
                <RadialGradientBrush MappingMode="Absolute" Center="128,176" GradientOrigin="128,176" RadiusX="86" RadiusY="70">
                    <GradientStop Color="#66AF47FF" Offset="0" />
                    <GradientStop Color="#00AF47FF" Offset="1" />
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Geometry>
                <EllipseGeometry Center="128,176" RadiusX="86" RadiusY="70" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- outline glow (layered wide strokes = vector "blur") -->
        <DrawingGroup Opacity="0.22">
            <GeometryDrawing Geometry="{StaticResource LogoGuitarGeometry}">
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource LogoGlowBrush}" Thickness="26" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
        <DrawingGroup Opacity="0.38">
            <GeometryDrawing Geometry="{StaticResource LogoGuitarGeometry}">
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource LogoGlowBrush}" Thickness="16" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
        <GeometryDrawing Geometry="{StaticResource LogoGuitarGeometry}">
            <GeometryDrawing.Pen>
                <Pen Brush="{StaticResource LogoStrokeBrush}" Thickness="9" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <DrawingGroup Opacity="0.35">
            <GeometryDrawing Geometry="{StaticResource LogoBarsGeometry}">
                <GeometryDrawing.Pen>
                    <Pen Brush="#AF47FF" Thickness="8" LineJoin="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
        <GeometryDrawing Brush="{StaticResource LogoBarsBrush}" Geometry="{StaticResource LogoBarsGeometry}" />
    </DrawingGroup>

    <DrawingImage x:Key="LogoMarkImage" Drawing="{StaticResource LogoMarkDrawing}" />

    <!-- App icon: mark on a matte squircle. -->
    <DrawingGroup x:Key="LogoIconDrawing">
        <GeometryDrawing Geometry="M0,128 C0,20 20,0 128,0 C236,0 256,20 256,128 C256,236 236,256 128,256 C20,256 0,236 0,128 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2B2D31" Offset="0" />
                    <GradientStop Color="#1E1F22" Offset="1" />
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Pen>
                <Pen Thickness="3">
                    <Pen.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40AF47FF" Offset="0" />
                            <GradientStop Color="#105865F2" Offset="0.6" />
                            <GradientStop Color="#305865F2" Offset="1" />
                        </LinearGradientBrush>
                    </Pen.Brush>
                </Pen>
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- mark at 84 % size, centred -->
        <ImageDrawing Rect="20.5,22,215,215" ImageSource="{StaticResource LogoMarkImage}" />
    </DrawingGroup>

    <DrawingImage x:Key="LogoIconImage" Drawing="{StaticResource LogoIconDrawing}" />
</ResourceDictionary>
